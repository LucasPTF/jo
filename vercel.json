{
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/angulo1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/angulo1", "destination": "/index.html" },
    { "source": "/angulo2", "destination": "/index.html" },
    { "source": "/angulo3", "destination": "/index.html" },
    { "source": "/obrigado", "destination": "/obrigado.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
